# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/salamty

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ─── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin@123456

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Mail (Gmail SMTP) ────────────────────────────────────────────────────────
# Enable "App Passwords" on your Google account and use that as MAIL_PASSWORD
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ─── Firebase Cloud Messaging (FCM) ───────────────────────────────────────────
# From your Firebase project → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=
# ─── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10